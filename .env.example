# Example environment variables
# Copy this to .env for local development (not needed for Netlify deployment)

GROQ_API_KEY=your_groq_api_key_here

# Last.fm, for the music lines. Free key at https://www.last.fm/api/account/create
# Without it the page just shows the plain last.fm link.
LASTFM_API_KEY=your_lastfm_api_key_here
